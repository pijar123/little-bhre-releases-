# Little Bhre - littlebhre.com
Options -Indexes
RewriteEngine On
# Paksa HTTPS dan tanpa www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://littlebhre.com%{REQUEST_URI} [L,R=301]
# Pengaman: alat admin tidak boleh bisa dibuka walau tidak sengaja ter-upload
RewriteRule (^|/)pembuat-kode [NC,F,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(woff2|webp|png|jpg|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
AddType font/woff2 .woff2
AddType image/webp .webp
